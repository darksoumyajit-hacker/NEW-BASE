# Railway Variables / local .env — do not commit real values
PORT=3000
NODE_ENV=production
ADMIN_API_KEY=replace-with-a-long-random-secret

# Telegram pairing bot. Leave BOT_TOKEN_TELEGRAM empty to disable Telegram pairing.
# Put Telegram channel/group IDs and public links in config.js.
BOT_TOKEN_TELEGRAM=
TG_ADMIN_IDS=

# Optional API keys. Features requiring these providers stay unavailable until configured.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
REMOVE_BG_API_KEY=
NEXORACLE_KEY=

# Optional private cookie file path. Do not upload cookie contents to GitHub.
COOKIES_FILE=./private/cookies.txt
